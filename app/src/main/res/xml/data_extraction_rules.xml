<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same intent as backup_rules.xml, for both cloud backup and device-to-device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="tasks.json" />
        <include domain="file" path="focus.json" />
        <include domain="sharedpref" path="appearance.xml" />
        <include domain="sharedpref" path="reminders.xml" />
        <include domain="sharedpref" path="focus.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="tasks.json" />
        <include domain="file" path="focus.json" />
        <include domain="sharedpref" path="appearance.xml" />
        <include domain="sharedpref" path="reminders.xml" />
        <include domain="sharedpref" path="focus.xml" />
    </device-transfer>
</data-extraction-rules>
